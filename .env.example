# Google Cloud Consoleで作成する「ウェブ アプリケーション」用OAuthクライアントID
# クライアントシークレットはこのファイルやアプリへ設定しないでください。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Google Cloud Consoleで作成する「デスクトップアプリ」用OAuthクライアントID
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# デスクトップ用クライアント作成時に表示・ダウンロードされるシークレット
# Electronメインプロセスだけが使用し、NEXT_PUBLIC_は付けません。
GOOGLE_DESKTOP_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Microsoft Entra管理センターで作成するSPA用アプリのクライアントID
# リダイレクトURIにはモバイル／Web版の /sync URLを登録します。
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 同じアプリ登録、またはデスクトップ用アプリ登録のクライアントID
# 「モバイルとデスクトップ アプリケーション」で http://localhost を有効にします。
# Microsoftのデスクトップ認証ではクライアントシークレットを使用しません。
NEXT_PUBLIC_MICROSOFT_DESKTOP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
